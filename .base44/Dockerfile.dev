# Build the same archive tool used by the production image, not application code.
FROM rust:bookworm AS monolith-builder
ARG MONOLITH_VERSION=2.10.1
RUN cargo install --locked monolith@${MONOLITH_VERSION}

# Dev runtime image only: system deps. Source is bind-mounted; deps installed at startup.
FROM node:22-bookworm-slim
COPY --from=monolith-builder /usr/local/cargo/bin/monolith /usr/local/bin/monolith
ARG DEBIAN_FRONTEND=noninteractive
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN apt-get update && \
    apt-get install -yqq --no-install-recommends curl ca-certificates openssl procps && \
    rm -rf /var/lib/apt/lists/*
# Chromium system libraries for the worker's Playwright archiving
RUN npx -y playwright@1.57.0 install-deps chromium && rm -rf /var/lib/apt/lists/* /root/.npm
RUN corepack enable
WORKDIR /app
